<Border x:Name="PanBack" x:Class="MyRadioButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource ColorBrushSemiTransparent}" CornerRadius="13.5" MinHeight="27" MaxHeight="27">
    <Grid>
        <StackPanel x:Name="PanContent" Orientation="Horizontal">
            <Path x:Name="ShapeLogo" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5" Margin="12,0,0,0" Stretch="Uniform" Fill="White" MaxHeight="16" MaxWidth="16" VerticalAlignment="Center" />
            <TextBlock x:Name="LabText" VerticalAlignment="Center" Grid.Column="1" Foreground="White" Margin="8,0,12,0" Grid.ColumnSpan="2" SnapsToDevicePixels="False" UseLayoutRounding="False" />
        </StackPanel>
        <!-- 侧边栏模式下的选中指示条 -->
        <Border x:Name="ShapeIndicator" Width="3" Height="20" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                Margin="-7,0,0,0" Background="Transparent" IsHitTestVisible="False" Visibility="Collapsed" />
    </Grid>
</Border>
