<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL"
    x:Class="PageInstanceResource"
    PanScroll="PanBack">
    <Grid>
        <Grid x:Name="PanAllBack">
            <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
                <StackPanel x:Name="PanMain" Margin="25,10,25,10">
                    <!-- 分类选择 -->
                    <StackPanel Orientation="Horizontal" Margin="0,15,0,10" x:Name="PanTypes">
                        <local:MyRadioButton Tag="0" ColorType="Highlight" Margin="2,0" Text="存档" x:Name="BtnTypeSaves" Checked="True" />
                        <local:MyRadioButton Tag="1" ColorType="Highlight" Margin="2,0" Text="截图" x:Name="BtnTypeScreenshots" />
                        <local:MyRadioButton Tag="2" ColorType="Highlight" Margin="2,0" Text="资源包" x:Name="BtnTypeResourcePacks" />
                        <local:MyRadioButton Tag="3" ColorType="Highlight" Margin="2,0" Text="光影包" x:Name="BtnTypeShaderPacks" />
                        <local:MyRadioButton Tag="4" ColorType="Highlight" Margin="2,0" Text="投影原理图" x:Name="BtnTypeSchematics" />
                        <local:MyRadioButton Tag="5" ColorType="Highlight" Margin="2,0" Text="服务器" x:Name="BtnTypeServers" />
                    </StackPanel>
                    <!-- 操作栏 -->
                    <local:MyCard Margin="0,0,0,15" x:Name="PanManage">
                        <Grid Margin="15,15,0,15" Height="35">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:MyButton x:Name="BtnOpen" Grid.Column="0" MinWidth="110" Text="打开文件夹" Padding="13,0" Margin="0,0,15,0" HorizontalAlignment="Left" ColorType="Highlight" />
                            <local:MyButton x:Name="BtnRefresh" Grid.Column="1" MinWidth="110" Text="刷新" Padding="13,0" HorizontalAlignment="Left" />
                        </Grid>
                    </local:MyCard>
                    <!-- 列表 -->
                    <local:MyCard x:Name="PanListBack" VerticalAlignment="Top" Margin="0,0,0,14" Title=" ">
                        <StackPanel Margin="20,42,18,18" Name="PanList" VerticalAlignment="Top" />
                    </local:MyCard>
                </StackPanel>
            </local:MyScrollViewer>
            <!-- 空态 -->
            <local:MyCard HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" x:Name="PanEmpty" Visibility="Collapsed">
                <StackPanel Margin="20,17">
                    <TextBlock Margin="0,0,0,9" HorizontalAlignment="Center" x:Name="LabEmptyTitle" Text="这里还没有内容" FontSize="19" UseLayoutRounding="True" SnapsToDevicePixels="True" Foreground="{DynamicResource ColorBrush3}" />
                    <Rectangle HorizontalAlignment="Stretch" Height="2" Fill="{DynamicResource ColorBrush3}" />
                    <TextBlock Margin="10,10,10,0" x:Name="LabEmptyInfo" Text="在游戏中使用该功能后，对应文件会出现在这里。" TextWrapping="Wrap" />
                </StackPanel>
            </local:MyCard>
        </Grid>
    </Grid>
</local:MyPageRight>
