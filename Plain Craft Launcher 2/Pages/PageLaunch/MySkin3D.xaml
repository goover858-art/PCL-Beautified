<UserControl x:Class="MySkin3D"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PCL"
             mc:Ignorable="d" Width="112" Height="120" Cursor="Hand">
    <Grid>
        <Viewport3D x:Name="View">
            <Viewport3D.Camera>
                <!-- 距离 70、水平 FOV 28°，模型 32 单位高时约填满 85% 高度；视线正对模型中心 y=16 -->
                <PerspectiveCamera x:Name="Cam" Position="0,16,70" LookDirection="0,0,-1" FieldOfView="28" />
            </Viewport3D.Camera>
            <!-- 灯光（不参与旋转）
                 环境光 0.36 + 主光 0.50 + 补光 0.30 + 轮廓光 0.20，
                 最亮面合计约 0.8，不会像原来那样叠到 2.5 倍而把皮肤映成一片白。 -->
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup>
                        <AmbientLight Color="#FF5C5C5C" />
                        <DirectionalLight Color="#FF808080" Direction="0.35,-1.00,-0.35" />
                        <DirectionalLight Color="#FF4D4D4D" Direction="-0.50,0.15,-0.90" />
                        <DirectionalLight Color="#FF333333" Direction="0.20,0.40,1.00" />
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
            <!-- 角色模型：绕模型中心 (0,16,0) 旋转，避免俯仰时绕脚底打转 -->
            <ModelVisual3D x:Name="Root">
                <ModelVisual3D.Content>
                    <Model3DGroup x:Name="Group" />
                </ModelVisual3D.Content>
                <ModelVisual3D.Transform>
                    <Transform3DGroup>
                        <TranslateTransform3D OffsetX="0" OffsetY="-16" OffsetZ="0" />
                        <RotateTransform3D>
                            <RotateTransform3D.Rotation>
                                <AxisAngleRotation3D x:Name="SpinY" Axis="0,1,0" Angle="0" />
                            </RotateTransform3D.Rotation>
                        </RotateTransform3D>
                        <RotateTransform3D>
                            <RotateTransform3D.Rotation>
                                <AxisAngleRotation3D x:Name="SpinX" Axis="1,0,0" Angle="0" />
                            </RotateTransform3D.Rotation>
                        </RotateTransform3D>
                        <TranslateTransform3D OffsetX="0" OffsetY="16" OffsetZ="0" />
                    </Transform3DGroup>
                </ModelVisual3D.Transform>
            </ModelVisual3D>
        </Viewport3D>
        <!-- 隐藏的 MySkin 仅用于复用披风修改逻辑，不参与显示 -->
        <local:MySkin x:Name="SkinHelper" Visibility="Collapsed" />
    </Grid>
</UserControl>
